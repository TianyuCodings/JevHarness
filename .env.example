# Jev via Vercel AI Gateway; never send this key to the direct TypeSafe API.
AI_GATEWAY_API_KEY=
# Optional direct TypeSafe transport:
TYPESAFE_API_KEY=
# Existing Azure-compatible gateway credential:
OPENAI_API_KEY=
# Direct OpenAI credential is separate so gateway keys are not sent to another service.
OPENAI_DIRECT_API_KEY=
# Optional Anthropic API credential. Local Claude login does not need this variable.
ANTHROPIC_API_KEY=
